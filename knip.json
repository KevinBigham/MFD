{
  "$schema": "https://unpkg.com/knip@6.4.1/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs,cjs}", "scripts/__tests__/*.{test,spec}.{ts,mjs,cjs}"],
      "project": ["scripts/**/*.{ts,mjs,cjs}"]
    },
    "packages/engine": {
      "entry": [
        "src/index.ts!",
        "src/rng/index.ts!",
        "src/types/index.ts!",
        "src/events/index.ts!",
        "src/config/index.ts!",
        "src/save/index.ts!",
        "src/**/*.test.ts"
      ],
      "project": ["src/**/*.ts"]
    },
    "packages/design-system": {
      "entry": [
        "components/index.ts!",
        "components/**/*.stories.tsx"
      ],
      "project": ["components/**/*.{ts,tsx}"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx!",
        "src/**/*.test.{ts,tsx}",
        "src/**/*.stories.tsx"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
